# Secrets / configuration locale
.env
.env.*
backend/config.php
backend/config.local.php
backend/config/*.local.php

# Dépendances
vendor/
node_modules/
# ...sauf les bibliothèques front copiées dans le site (Chart.js) : elles
# partent en production avec frontend/, il faut les commiter.
!frontend/js/vendor/

# Dumps et sauvegardes base de données
*.sql
*.sql.gz
*.dump
# ...mais les migrations SONT du code : elles doivent être commitées.
!migrations/*.sql

# Logs
*.log
logs/

# Éditeurs / IDE
.vscode/
.idea/
*.swp
*~

# Système
.DS_Store
Thumbs.db
desktop.ini

# Déploiement
.ftp-deploy-sync-state.json

# Aperçu local
.claude/launch.json
