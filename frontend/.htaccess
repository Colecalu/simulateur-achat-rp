# ===========================================================================
#  Æquo — configuration Apache (OVH mutualisé). frontend/ est la racine web.
#
#  NE SE TESTE PAS EN LOCAL : le petit serveur de lancer-le-site.cmd
#  (http-server) l'ignore. Il sert déjà /simulateur tout seul (il ajoute
#  .html quand l'adresse n'a pas d'extension), si bien que les liens
#  fonctionnent dans les deux mondes. Vérifications à faire au premier
#  déploiement : voir CLAUDE.md §13, « Au premier déploiement ».
# ===========================================================================

# Page d'erreur : un chemin LOCAL (pas une URL complète), pour qu'Apache
# garde le code 404 au lieu de rediriger. Servie à l'adresse demandée, quelle
# qu'elle soit : 404.html n'utilise donc que des chemins absolus.
ErrorDocument 404 /404.html

# MultiViews laisse Apache choisir lui-même un fichier quand l'extension
# manque : il servirait /simulateur à sa façon, avant nos règles, et les
# redirections ci-dessous deviendraient imprévisibles.
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS et domaine sans www — ACTIF depuis le 08/10/2026 -------------
  # Une seule adresse canonique : https://aequo-immo.fr, sans www. Tout le
  # reste (http, www, ou les deux) repart en 301 vers elle, chemin et
  # paramètres conservés. EN TÊTE des règles : une page demandée en http doit
  # changer de protocole avant toute réécriture d'adresse propre.
  #
  # Prérequis, vérifié le 08/10/2026 : certificat Let's Encrypt actif sur
  # aequo-immo.fr ET www.aequo-immo.fr. S'il venait à expirer ou à être
  # retiré dans l'espace client OVH, recommenter ces trois lignes : sans
  # certificat, la redirection rendrait le site inaccessible.
  #
  # Test du port plutôt que de %{HTTPS} : c'est la forme que donne le guide
  # d'OVH pour ses hébergements mutualisés. Si une page boucle en
  # redirection, c'est ce test qu'il faut revoir.
  RewriteCond %{SERVER_PORT} 80 [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://aequo-immo.fr%{REQUEST_URI} [R=301,L,NE]
  #
  # HSTS : prévu le 15/10/2026, ligne commentée plus bas (mod_headers).
  # -------------------------------------------------------------------------

  # Les cibles des 301 ci-dessous sont des URL COMPLÈTES : avec un simple
  # « /simulateur », Apache, derrière le frontal HTTPS d'OVH, reconstruisait
  # https://aequo-immo.fr:443/simulateur (constaté en ligne le 08/10/2026).
  # Ça marchait, mais ce n'était pas l'adresse canonique.

  # Une seule adresse par page, sinon les moteurs de recherche voient deux
  # pages identiques et partagent leur crédit entre elles. On ne redirige que
  # ce que le VISITEUR a demandé (THE_REQUEST) : la réécriture interne de
  # /simulateur vers simulateur.html, plus bas, repasse par ces règles et
  # bouclerait sans cette condition.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://aequo-immo.fr/ [R=301,L]

  # Les pages à adresse propre : le simulateur et les deux pages légales.
  # Une nouvelle page s'ajoute dans les TROIS règles ci-dessous.
  RewriteCond %{THE_REQUEST} \s/+(simulateur|mentions-legales|confidentialite)\.html[\s?] [NC]
  RewriteRule ^(simulateur|mentions-legales|confidentialite)\.html$ https://aequo-immo.fr/$1 [R=301,L]

  # Avec une barre finale, les chemins relatifs de la page (css/, js/)
  # partiraient de /simulateur/ et ne trouveraient rien : la page serait nue.
  RewriteRule ^(simulateur|mentions-legales|confidentialite)/$ https://aequo-immo.fr/$1 [R=301,L]

  # L'adresse propre, servie sans redirection visible. Les fichiers qui
  # existent (css/, js/, fonts/, img/, favicon, robots.txt, sitemap.xml)
  # ne sont concernés par aucune de ces règles : elles ne visent que ces
  # adresses précises.
  RewriteRule ^(simulateur|mentions-legales|confidentialite)$ $1.html [L]
</IfModule>

# OVH sert les .woff2 sans type de contenu (constaté le 08/10/2026). Les
# navigateurs les chargent quand même, mais un type déclaré évite qu'un
# navigateur ou un proxy strict les refuse.
AddType font/woff2 .woff2

# robots.txt, llms.txt et la clé IndexNow sont du texte UTF-8 (« Æquo »,
# accents) : sans charset déclaré, un robot peut les lire en Latin-1.
AddCharset utf-8 .txt

<IfModule mod_headers.c>

  # --- Cache -----------------------------------------------------------
  # Les polices ne changent jamais sous le même nom : un an de cache évite
  # de les retélécharger à chaque visite. Si une police change, changer son
  # nom de fichier (et polices.css), sinon les visiteurs garderaient
  # l'ancienne un an.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML, CSS et JS : « no-cache » ne veut pas dire « pas de cache », mais
  # « redemander au serveur avant chaque usage ». Le navigateur garde sa
  # copie et envoie If-Modified-Since ; OVH répond 304, sans le fichier, tant
  # que rien n'a changé (vérifié le 08/10/2026). Un visiteur ne peut donc
  # JAMAIS combiner une page neuve et un app.js ancien après un déploiement.
  # Sans cette règle, OVH impose 15 minutes de cache (max-age=900) aux CSS
  # et JS, et rien au HTML. On retire aussi son Expires, qui disait pareil.
  # Choisi contre un numéro de version injecté par le workflow : ce serait
  # une étape de build, et les fichiers en ligne ne seraient plus ceux du
  # dépôt.
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>

  # --- Sécurité --------------------------------------------------------
  # « always » : aussi sur les 301 et la 404, pas seulement sur les 200.

  # Le navigateur s'en tient au type annoncé : un fichier servi en texte ne
  # peut pas être exécuté comme script.
  Header always set X-Content-Type-Options "nosniff"

  # Vers un autre site, on ne transmet que l'origine, jamais l'adresse de la
  # page.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Aucune page d'Æquo ne peut être affichée dans le cadre (iframe) d'un
  # autre site. X-Frame-Options pour les anciens navigateurs, frame-ancestors
  # (dans la CSP) pour les autres.
  Header always set X-Frame-Options "DENY"

  # Politique de sécurité du contenu (CSP) : tout vient du site lui-même,
  # rien d'autre n'est autorisé. Possible parce que le site n'a AUCUN script
  # ni style en ligne (règle de CLAUDE.md §5), et que polices et Chart.js
  # sont hébergés ici. Le bloc JSON-LD de l'accueil n'est pas concerné :
  # c'est une donnée, pas un script exécuté.
  # Seule exception : Google Analytics 4 (08/10/2026, js/mesure.js), au strict
  # nécessaire de la liste publiée par Google pour GA4 — gtag.js depuis
  # googletagmanager.com (script-src), les mesures vers google-analytics.com
  # et analytics.google.com (connect-src ; img-src pour le repli en pixel).
  # Toujours aucun 'unsafe-inline' : l'initialisation de gtag est dans
  # mesure.js, pas dans un extrait collé dans la page.
  # ⚠️ Tout AUTRE service extérieur doit être ajouté ici, sinon il sera
  # bloqué en silence. Voir CLAUDE.md §13.
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self' https://*.googletagmanager.com; style-src 'self'; img-src 'self' https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"

  # HSTS — PRÉVU LE 15/10/2026, une semaine après la redirection HTTPS
  # (checklist de CLAUDE.md §13). Une fois envoyé, les navigateurs refusent
  # le http:// du site pendant un an : on ne l'active qu'après une semaine
  # sans incident sur le certificat et la redirection. Pas de
  # includeSubDomains ni de preload : ils engageraient tous les
  # sous-domaines, et preload ne se retire pas.
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
